# Copy to .env locally; enter actual credentials only in secure settings/.env.
TELEGRAM_BOT_TOKEN=
XAI_API_KEY=
BOT_ADMIN_USER_ID=0
# VA_CHAT_ID defaults to BOT_ADMIN_USER_ID when omitted.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL_NAME=ginger
PROFILE_MODEL_NAME=ginger
ROLEPLAY_CHARACTER="Ginger, a fictional 21-year-old British woman from Manchester; warm, witty, playful, interested in R&B and techno."
# Remove an old SYSTEM_PROMPT from your .env to use the shared prompt file below.
# A nonempty SYSTEM_PROMPT takes precedence over SYSTEM_PROMPT_FILE.
SYSTEM_PROMPT_FILE=system_prompt.txt
# Only Grok receives these additional instructions, after the profile handoff.
GROK_SYSTEM_PROMPT_FILE=grok_prompt.txt
XAI_MODEL=grok-4.3
PROFILE_DB_PATH=client_profiles.sqlite3
ENABLE_DIRECT_TEST_MODE=false
HANDOFF_INCLUDE_TRANSCRIPT=false
PROFILE_RETENTION_DAYS=30
PLAN_MEMORY_DAYS=7
# Existing .env values override these new defaults. Set both to 0 for local tests.
REPLY_DELAY_MIN_SECONDS=10
REPLY_DELAY_MAX_SECONDS=25
