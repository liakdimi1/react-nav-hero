# Copy to .env locally; enter actual credentials only in secure settings/.env.
TELEGRAM_BOT_TOKEN=
XAI_API_KEY=
BOT_ADMIN_USER_ID=0
# VA_CHAT_ID defaults to BOT_ADMIN_USER_ID when omitted.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL_NAME=qwen2.5:3b
XAI_MODEL=grok-4.3
PROFILE_DB_PATH=client_profiles.sqlite3
ENABLE_DIRECT_TEST_MODE=false
HANDOFF_INCLUDE_TRANSCRIPT=false
PROFILE_RETENTION_DAYS=30
# Original delays preserved. For local testing only, set both to 0.
REPLY_DELAY_MIN_SECONDS=60
REPLY_DELAY_MAX_SECONDS=180
