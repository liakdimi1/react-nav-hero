# Keep actual credentials in .env or secure environment settings.
TELEGRAM_BOT_TOKEN=
BOT_ADMIN_USER_ID=0
# Both chat and JSON extraction always use this one local model.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL_NAME=ginger
LOCAL_MODEL_TIMEOUT_SECONDS=600
MODEL_CONCURRENCY=1
ROLEPLAY_CHARACTER="Ginger, a fictional 21-year-old British woman from Manchester; warm, witty, playful, interested in R&B and techno."
# An existing nonempty SYSTEM_PROMPT overrides the file. Keep your own prompts.
SYSTEM_PROMPT_FILE=system_prompt.txt
PROFILE_DB_PATH=client_profiles.sqlite3
PROFILE_EXTRACTION_ENABLED=true
ENABLE_DIRECT_TEST_MODE=false
PROFILE_RETENTION_DAYS=30
PLAN_MEMORY_DAYS=7
# Fast delivery; existing .env settings still override defaults.
REPLY_DELAY_MODE=random
REPLY_DELAY_MIN_SECONDS=0
REPLY_DELAY_MAX_SECONDS=0
MIN_TYPING_SECONDS=0
MAX_TYPING_SECONDS=0
POST_GENERATION_PAUSE_MIN_SECONDS=0
POST_GENERATION_PAUSE_MAX_SECONDS=0
